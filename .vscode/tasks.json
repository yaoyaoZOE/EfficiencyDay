{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db: migrate",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "alembic", "upgrade", "head"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "problemMatcher": []
    },
    {
      "label": "dev: backend",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m", "uvicorn", "app.main:app",
        "--host", "127.0.0.1", "--port", "6931", "--reload"
      ],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "dependsOn": "db: migrate",
      "isBackground": true,
      "problemMatcher": {
        "owner": "efficiencyday-backend",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*",
          "endsPattern": ".*Application startup complete.*"
        }
      }
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "efficiencyday-frontend",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*8327.*"
        }
      }
    },
    {
      "label": "dev: all",
      "dependsOn": ["dev: backend", "dev: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "test: backend",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "problemMatcher": []
    },
    {
      "label": "test: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "problemMatcher": []
    },
    {
      "label": "build: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    }
  ]
}
