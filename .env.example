# Set to the exact browser-facing origin. Browser writes fail closed until this is set correctly.
EFFICIENCYDAY_PUBLIC_ORIGIN=https://example.com
# Set both only to create the first account on an empty, migrated database.
# EFFICIENCYDAY_INITIAL_USERNAME=
# EFFICIENCYDAY_INITIAL_PASSWORD=
# Session lifetime in days; must be positive.
EFFICIENCYDAY_SESSION_TTL_DAYS=7
# Keep true for HTTPS. Explicit false enables insecure HTTP sessions; traffic is unencrypted.
EFFICIENCYDAY_SESSION_COOKIE_SECURE=true
EFFICIENCYDAY_BIND_ADDRESS=127.0.0.1
EFFICIENCYDAY_PORT=8327
